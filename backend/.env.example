# 服务端口
PORT=3000
NODE_ENV=development

# 数据库配置
DATABASE_URL="mysql://root:your_password@localhost:3306/mantianxing?schema=public&charset=utf8mb4"

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT 配置
JWT_SECRET=mantianxing_jwt_secret_change_this_in_production
JWT_EXPIRES_IN=7d

# 虚拟币配置（1元 = 10星石）
COIN_EXCHANGE_RATE=10

# 上传配置
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Kook 机器人配置（可选，不配置则不启动机器人）
KOOK_BOT_TOKEN=your_kook_bot_token_here
KOOK_ORDER_CHANNEL_ID=your_order_channel_id_here
KOOK_VERIFY_TOKEN=your_kook_verify_token_here
