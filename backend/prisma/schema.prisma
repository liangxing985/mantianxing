// 漫天星电竞 - 陪玩管理平台数据库设计
// 生成命令：npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==================== 用户体系 ====================

// 用户表（老板、陪玩、管理员统一表，用 role 区分）
model User {
  id            Int      @id @default(autoincrement())
  username      String   @unique @db.VarChar(50) // 登录用户名
  password      String   @db.VarChar(255) // bcrypt 加密
  phone         String?  @unique @db.VarChar(20) // 手机号
  nickname      String   @db.VarChar(50) // 昵称
  avatar        String?  @db.VarChar(255) // 头像URL
  role          Role     @default(CUSTOMER) // 角色：CUSTOMER老板 / PROVIDER陪玩 / ADMIN管理员 / OPERATOR客服
  status        UserStatus @default(ACTIVE) // 账号状态
  realName      String?  @db.VarChar(50) // 真实姓名
  idCard        String?  @db.VarChar(18) // 身份证号
  isVerified    Boolean  @default(false) // 是否实名认证
  gender        Gender?  @default(UNKNOWN)
  bio           String?  @db.Text // 个人简介
  kookId        String?  @unique @db.VarChar(50) // Kook 用户ID（绑定机器人）
  inviteCode    String?  @unique @db.VarChar(20) // 邀请码
  inviterId     Int?     // 邀请人ID
  depositBalance Int     @default(0) // 保证金余额（星石）
  membershipLevel Int    @default(0) // 会员等级 0=普通 1=青铜 2=白银 3=黄金 4=钻石 5=王者
  membershipExpireAt DateTime? // 会员到期时间
  voiceTag      String?  @db.VarChar(50) // 声音标签：萝莉音/御姐音/青叔音/少女音等
  totalGiftsReceived Int @default(0) // 累计收到礼物价值（星石）
  lastLoginAt   DateTime?
  lastLoginIp   String?  @db.VarChar(50)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // 关联
  wallet        Wallet?
  orders        Order[]         @relation("CustomerOrders")
  providerOrders Order[]        @relation("ProviderOrders")
  reviews       Review[]        @relation("CustomerReviews")
  providerReviews Review[]      @relation("ProviderReviews")
  messages      Message[]       @relation("UserMessages")
  withdrawals   Withdraw[]
  providerProfile ProviderProfile?
  adminLogs     AdminLog[]
  chatMessages  ChatMessage[]
  conversationsAsUser1 Conversation[] @relation("User1Conversations")
  conversationsAsUser2 Conversation[] @relation("User2Conversations")
  giftSent      GiftRecord[]    @relation("GiftSender")
  giftReceived  GiftRecord[]    @relation("GiftReceiver")
  inviteRecords InviteRecord[]  @relation("Inviter")
  invitedBy     InviteRecord?   @relation("Invitee")
  commissions   CommissionRecord[]
  skillTags     UserSkillTag[]
  depositRecords DepositRecord[]
  userCoupons   UserCoupon[]
  paymentOrders PaymentOrder[]
  dispatchRecordsAsOperator DispatchRecord[] @relation("DispatchOperator")
  dispatchRecordsAsFrom DispatchRecord[]     @relation("DispatchFrom")
  dispatchRecordsAsTo DispatchRecord[]       @relation("DispatchTo")

  @@index([role])
  @@index([status])
  @@map("users")
}

// 陪玩资料表（扩展信息）
model ProviderProfile {
  id            Int      @id @default(autoincrement())
  userId        Int      @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  voiceCard     String?  @db.VarChar(255) // 语音介绍URL
  introVideo    String?  @db.VarChar(255) // 介绍视频URL
  level         Int      @default(1) // 陪玩等级 1-10
  rating        Float    @default(5.0) // 评分 0-5
  ratingCount   Int      @default(0) // 评价数
  orderCount    Int      @default(0) // 完成订单数
  totalIncome   Int      @default(0) // 累计收入（星石）
  isOnline      Boolean  @default(false) // 是否在线
  acceptOrder   Boolean  @default(true) // 是否接单
  onlineStatus  OnlineStatus @default(OFFLINE)
  rank          String?  @db.VarChar(50) // 游戏段位：王者/星耀/钻石/铂金/黄金/白银/青铜
  applyStatus   ApplyStatus @default(PENDING) // 入驻审核状态
  applyReason   String?  @db.Text // 申请理由
  rejectReason  String?  @db.Text // 拒绝理由
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // 关联
  services      ProviderService[]
  games         ProviderGame[]

  @@index([isOnline])
  @@index([acceptOrder])
  @@map("provider_profiles")
}

// 陪玩游戏关联表（陪玩擅长哪些游戏）
model ProviderGame {
  id              Int      @id @default(autoincrement())
  providerId      Int
  providerProfile ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  gameId          Int
  game            Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  status          String   @default("APPROVED") // PENDING / APPROVED / REJECTED
  createdAt       DateTime @default(now())

  @@unique([providerId, gameId])
  @@map("provider_games")
}

// 陪玩服务关联表（陪玩能提供哪些服务及定价）
model ProviderService {
  id              Int      @id @default(autoincrement())
  providerId      Int
  providerProfile ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  serviceItemId   Int
  serviceItem     ServiceItem @relation(fields: [serviceItemId], references: [id])
  price           Int      // 单价（星石/小时或局）
  unit            String   @db.VarChar(20) // 计价单位：hour局 / game局 / package包段
  description     String?  @db.Text // 服务说明
  isEnabled       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([providerId, serviceItemId])
  @@map("provider_services")
}

// ==================== 游戏与服务 ====================

// 游戏类目表
model Game {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(50) // 游戏名称：王者荣耀、和平精英、三角洲行动等
  icon        String?  @db.VarChar(255) // 游戏图标
  categoryId  Int?     // 游戏分类ID
  category    GameCategory? @relation(fields: [categoryId], references: [id])
  servers     String?  @db.Text // 区服配置JSON：["QQ","微信","微信IOS","微信安卓"]
  sortOrder   Int      @default(0) // 排序
  isEnabled   Boolean  @default(true) // 独立开关
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  serviceItems ServiceItem[]
  providerGames ProviderGame[]
  gamePricings GamePricing[]
  products Product[]
  ranks GameRank[]

  @@map("games")
}

// 游戏分类表（标准化分类）
model GameCategory {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(50) // 分类名称：端游、手游、MOBA、FPS、战术撤离、派对休闲等
  icon        String?  @db.VarChar(255) // 分类图标
  sortOrder   Int      @default(0) // 排序
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())

  games Game[]

  @@map("game_categories")
}

// 游戏段位配置表
model GameRank {
  id          Int      @id @default(autoincrement())
  gameId      Int
  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  name        String   @db.VarChar(50) // 段位名称：青铜、白银、黄金、...、王者
  level       Int      @default(1) // 段位等级（用于排序和按段位定价）
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@unique([gameId, name])
  @@index([gameId])
  @@map("game_ranks")
}

// 优惠券表
model Coupon {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100) // 优惠券名称
  type        String   @db.VarChar(20) // 类型：FIXED满减 / DISCOUNT折扣 / NEWBIE新人
  discountValue Int    // 优惠值：FIXED为减多少星石，DISCOUNT为折扣(如80表示8折)
  minAmount   Int      @default(0) // 最低使用金额（星石）
  totalCount  Int      @default(0) // 发放总量，0表示不限
  usedCount   Int      @default(0) // 已使用数量
  perUserLimit Int     @default(1) // 每人限领数量
  startTime   DateTime? // 生效时间
  endTime     DateTime? // 过期时间
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())

  userCoupons UserCoupon[]

  @@map("coupons")
}

// 用户优惠券表
model UserCoupon {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  couponId    Int
  coupon      Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  status      String   @default("UNUSED") @db.VarChar(20) // UNUSED未使用 / USED已使用 / EXPIRED已过期
  orderId     Int?     // 使用的订单ID
  usedAt      DateTime? // 使用时间
  expireAt    DateTime? // 过期时间
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([couponId])
  @@map("user_coupons")
}

// 服务项目表
model ServiceItem {
  id          Int      @id @default(autoincrement())
  gameId      Int
  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  name        String   @db.VarChar(50) // 服务名称：陪玩、代练、教学、上分等
  description String?  @db.Text
  defaultPrice Int     @default(0) // 默认参考价（星石）
  unit        String   @default("hour") @db.VarChar(20) // 默认计价单位
  sortOrder   Int      @default(0)
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  providerServices ProviderService[]
  orders           Order[]

  @@index([gameId])
  @@map("service_items")
}

// 游戏段位定价表（按游戏+陪玩段位设置小时价格，管理后台统一配置）
model GamePricing {
  id           Int      @id @default(autoincrement())
  gameId       Int
  game         Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  rank         String   @db.VarChar(50) // 陪玩段位：王者/星耀/钻石/铂金/黄金/白银/青铜
  pricePerHour Int      // 每小时价格（星石）
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([gameId, rank])
  @@map("game_pricings")
}

// ==================== 订单体系 ====================

// 订单表（核心）
model Order {
  id              Int      @id @default(autoincrement())
  orderNo         String   @unique @db.VarChar(32) // 订单号
  customerId      Int
  customer        User     @relation("CustomerOrders", fields: [customerId], references: [id])
  providerId      Int?
  provider        User?    @relation("ProviderOrders", fields: [providerId], references: [id])
  gameId          Int
  serviceItemId   Int
  serviceItem     ServiceItem @relation(fields: [serviceItemId], references: [id])
  title           String   @db.VarChar(100) // 订单标题
  orderGroup      String?  @db.VarChar(32) // 订单组ID，双陪/多人订单共享同一个group
  requirement     String?  @db.Text // 老板要求
  duration        Int      @default(1) // 数量（小时/局数）
  unitPrice       Int      // 单价（星石）
  totalAmount     Int      // 总金额（星石）
  platformFee     Int      @default(0) // 平台抽成（星石）
  providerIncome  Int      @default(0) // 陪玩实际收入（星石）
  status          OrderStatus @default(CREATED) // 订单状态
  contactType     String?  @db.VarChar(20) // 联系方式类型：qq / wechat / phone
  contactValue    String?  @db.VarChar(100) // 联系方式
  gameAccount     String?  @db.VarChar(100) // 游戏账号/区服
  // 时间
  paidAt          DateTime? // 支付时间
  acceptedAt      DateTime? // 接单时间
  startedAt       DateTime? // 开始服务时间
  submittedAt     DateTime? // 提交报单时间
  reviewedAt      DateTime? // 审核时间
  completedAt     DateTime? // 完成时间
  cancelledAt     DateTime? // 取消时间
  cancelReason    String?  @db.Text
  expireAt        DateTime? // 过期时间
  // 审核
  reviewStatus    ReviewStatus? @default(PENDING) // 报单审核状态
  reviewerId      Int?
  reviewComment   String?  @db.Text
  // 评价
  customerRating  Int?     // 老板评分 1-5
  customerComment String?  @db.Text
  providerReply   String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // 关联
  evidences       OrderEvidence[]
  walletTxns      WalletTransaction[]
  messages        Message[]
  dispatchRecords DispatchRecord[]

  @@index([customerId])
  @@index([providerId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

// 订单报单凭证表
model OrderEvidence {
  id          Int      @id @default(autoincrement())
  orderId     Int
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type        EvidenceType // 凭证类型：ENTER入队 / END结单 / RESULT战绩 / OTHER其他
  imageUrl    String   @db.MediumText // 截图URL（MVP阶段存base64/dataURL）
  description String?  @db.VarChar(200)
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@map("order_evidences")
}

// ==================== 钱包体系 ====================

// 钱包表
model Wallet {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance     Int      @default(0) // 可用余额（星石）
  frozen      Int      @default(0) // 冻结金额（星石，进行中订单）
  totalIncome Int      @default(0) // 累计收入
  totalRecharge Int    @default(0) // 累计充值
  totalWithdraw Int    @default(0) // 累计提现
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions WalletTransaction[]

  @@map("wallets")
}

// 钱包流水表（只增不改，审计用）
model WalletTransaction {
  id          Int      @id @default(autoincrement())
  walletId    Int
  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  userId      Int
  type        TxnType  // 类型：RECHARGE充值 / CONSUME消费 / INCOME收入 / WITHDRAW提现 / REFUND退款 / REWARD奖励 / PUNISH惩罚 / GIFT礼物 / FROZEN冻结 / UNFROZEN解冻
  amount      Int      // 变动金额（正数增加，负数减少）
  balanceAfter Int     // 变动后余额
  orderId     Int?
  order       Order?   @relation(fields: [orderId], references: [id])
  remark      String?  @db.VarChar(200) // 备注
  operatorId  Int?     // 操作人（后台充值/奖惩时）
  createdAt   DateTime @default(now())

  @@index([walletId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@map("wallet_transactions")
}

// 提现申请表
model Withdraw {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  amount      Int      // 提现金额（星石）
  realAmount  Float    // 实际到账金额（元）
  fee         Int      @default(0) // 手续费（星石）
  payMethod   String   @db.VarChar(20) // 提现方式：alipay支付宝 / wechat微信 / bank银行卡
  payAccount  String   @db.VarChar(100) // 收款账号
  payName     String   @db.VarChar(50) // 收款人姓名
  status      WithdrawStatus @default(PENDING)
  reviewerId  Int?
  reviewComment String? @db.Text
  paidAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@map("withdraws")
}

// ==================== 消息与评价 ====================

// 消息表
model Message {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation("UserMessages", fields: [userId], references: [id])
  type        MessageType // SYSTEM系统 / ORDER订单 / NOTICE公告
  title       String   @db.VarChar(100)
  content     String   @db.Text
  orderId     Int?
  order       Order?   @relation(fields: [orderId], references: [id])
  isRead      Boolean  @default(false)
  readAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@map("messages")
}

// 评价表（独立存储，方便统计）
model Review {
  id          Int      @id @default(autoincrement())
  orderId     Int      @unique
  customerId  Int
  customer    User     @relation("CustomerReviews", fields: [customerId], references: [id])
  providerId  Int
  provider    User     @relation("ProviderReviews", fields: [providerId], references: [id])
  rating      Int      // 1-5星
  content     String?  @db.Text
  tags        String?  @db.VarChar(200) // 标签，逗号分隔
  providerReply String? @db.Text
  isAnonymous Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([providerId])
  @@index([rating])
  @@map("reviews")
}

// ==================== 系统管理 ====================

// 管理员操作日志
model AdminLog {
  id          Int      @id @default(autoincrement())
  adminId     Int
  admin       User     @relation(fields: [adminId], references: [id])
  action      String   @db.VarChar(50) // 操作类型
  targetType  String   @db.VarChar(50) // 操作对象类型
  targetId    Int?     // 操作对象ID
  detail      String?  @db.Text // 操作详情
  ip          String?  @db.VarChar(50)
  createdAt   DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@map("admin_logs")
}

// 系统配置表（键值对，后台可配置）
model SystemConfig {
  id          Int      @id @default(autoincrement())
  key         String   @unique @db.VarChar(100)
  value       String   @db.Text
  description String?  @db.VarChar(200)
  updatedAt   DateTime @updatedAt

  @@map("system_configs")
}

// ==================== 商品与活动 ====================

// 商品表（老板端展示的可购买商品/服务套餐）
model Product {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(100) // 商品名称
  description String?  @db.Text // 商品描述
  price       Int      // 价格（星石）
  originalPrice Int?   // 原价（星石，用于划线价）
  gameId      Int?     // 关联游戏（可选）
  game        Game?    @relation(fields: [gameId], references: [id], onDelete: SetNull)
  category    String   @default("normal") @db.VarChar(30) // 分类：normal普通 / hot热门 / discount折扣
  image       String?  @db.MediumText // 商品图片（base64或URL）
  durationOptions String? @db.Text // 可选时长配置JSON，如[{"label":"1小时","value":1}]
  sortOrder   Int      @default(0) // 排序
  isActive    Boolean  @default(true) // 是否上架
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isActive])
  @@map("products")
}

// 活动表（老板端展示的活动/Banner）
model Activity {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(100) // 活动标题
  content     String?  @db.Text // 活动内容/详情
  image       String?  @db.MediumText // 活动图片（base64或URL）
  linkUrl     String?  @db.VarChar(500) // 跳转链接（可选）
  startTime   DateTime? // 开始时间
  endTime     DateTime? // 结束时间
  sortOrder   Int      @default(0) // 排序
  isActive    Boolean  @default(true) // 是否发布
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@map("activities")
}

// ==================== 轮播图Banner ====================

model Banner {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(100) // 标题
  image       String   @db.MediumText // 图片URL
  linkUrl     String?  @db.VarChar(500) // 跳转链接（可选）
  sortOrder   Int      @default(0) // 排序
  isActive    Boolean  @default(true) // 是否启用
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
  @@map("banners")
}

// ==================== 支付订单（ShareFlow码支付） ====================

model PaymentOrder {
  id            Int      @id @default(autoincrement())
  userId        Int      // 下单用户ID
  outOrderNo    String   @unique @db.VarChar(64) // 商户订单号
  shareflowNo   String?  @db.VarChar(64) // ShareFlow系统订单号
  amount        Decimal  @db.Decimal(10, 2) // 支付金额（元）
  coinAmount    Int      // 兑换星石数量
  productName   String   @db.VarChar(200) // 商品名称
  payStatus     String   @default("pending_pay") @db.VarChar(20) // pending_pay/pending_confirm/paid/expired
  payUrl        String?  @db.VarChar(500) // 支付页面地址
  wechatQr      String?  @db.Text // 微信二维码
  alipayQr      String?  @db.Text // 支付宝二维码
  paidAt        DateTime? // 支付时间
  expireAt      DateTime? // 过期时间
  transactionId String?  @db.VarChar(100) // 微信/支付宝交易号
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([outOrderNo])
  @@index([payStatus])
  @@map("payment_orders")
}

// ==================== 即时通讯IM ====================

// 会话表（一对一聊天）
model Conversation {
  id          Int      @id @default(autoincrement())
  user1Id     Int
  user1       User     @relation("User1Conversations", fields: [user1Id], references: [id])
  user2Id     Int
  user2       User     @relation("User2Conversations", fields: [user2Id], references: [id])
  lastMessage String?  @db.Text // 最后一条消息摘要
  lastMessageAt DateTime? // 最后消息时间
  user1Unread Int      @default(0) // user1未读数
  user2Unread Int      @default(0) // user2未读数
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages    ChatMessage[]

  @@unique([user1Id, user2Id])
  @@index([lastMessageAt])
  @@map("conversations")
}

// 聊天消息表
model ChatMessage {
  id             Int      @id @default(autoincrement())
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       Int
  sender         User     @relation(fields: [senderId], references: [id])
  type           String   @default("text") @db.VarChar(20) // text文字 / image图片 / voice语音 / system系统
  content        String   @db.Text // 消息内容
  isRead         Boolean  @default(false)
  readAt         DateTime?
  createdAt      DateTime @default(now())

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@map("chat_messages")
}

// ==================== 会员体系 ====================

// 会员等级配置表
model MembershipLevel {
  id          Int      @id @default(autoincrement())
  level       Int      @unique // 等级 1-5
  name        String   @db.VarChar(50) // 名称：青铜/白银/黄金/钻石/王者
  price       Int      // 月费（星石）
  icon        String?  @db.VarChar(255) // 图标
  benefits    String?  @db.Text // 权益描述JSON
  sortOrder   Int      @default(0)
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("membership_levels")
}

// 会员购买/续费记录
model MembershipRecord {
  id          Int      @id @default(autoincrement())
  userId      Int
  level       Int      // 购买的等级
  months      Int      // 购买月数
  amount      Int      // 花费星石
  startTime   DateTime @default(now())
  endTime     DateTime // 到期时间
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("membership_records")
}

// ==================== 保证金体系 ====================

// 保证金缴纳/退还记录
model DepositRecord {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  type        String   @db.VarChar(20) // DEPOSIT缴纳 / REFUND退还 / FREEZE冻结 / UNFREEZE解冻 / DEDUCT扣除
  amount      Int      // 金额（星石）
  balanceAfter Int     // 变动后保证金余额
  orderId     Int?     // 关联订单（扣除保证金时）
  remark      String?  @db.VarChar(200)
  operatorId  Int?     // 操作人
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([type])
  @@map("deposit_records")
}

// ==================== 礼物打赏 ====================

// 礼物配置表
model Gift {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(50) // 礼物名称
  icon        String   @db.VarChar(255) // 礼物图标/动画
  price       Int      // 价格（星石）
  category    String   @default("normal") @db.VarChar(20) // normal普通 / luxury豪华 / special特效
  animation   String?  @db.VarChar(255) // 特效动画URL
  sortOrder   Int      @default(0)
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  records     GiftRecord[]

  @@map("gifts")
}

// 礼物打赏记录表
model GiftRecord {
  id          Int      @id @default(autoincrement())
  senderId    Int
  sender      User     @relation("GiftSender", fields: [senderId], references: [id])
  receiverId  Int
  receiver    User     @relation("GiftReceiver", fields: [receiverId], references: [id])
  giftId      Int
  gift        Gift     @relation(fields: [giftId], references: [id])
  quantity    Int      @default(1) // 数量
  totalAmount Int      // 总价值（星石）
  orderId     Int?     // 关联订单（订单内打赏）
  message     String?  @db.VarChar(200) // 附言
  createdAt   DateTime @default(now())

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
  @@map("gift_records")
}

// ==================== 分销/邀请 ====================

// 邀请记录表
model InviteRecord {
  id          Int      @id @default(autoincrement())
  inviterId   Int      // 邀请人
  inviter     User     @relation("Inviter", fields: [inviterId], references: [id])
  inviteeId   Int      @unique // 被邀请人
  invitee     User     @relation("Invitee", fields: [inviteeId], references: [id])
  rewardAmount Int     @default(0) // 已发放奖励（星石）
  status      String   @default("PENDING") @db.VarChar(20) // PENDING待奖励 / REWARDED已奖励
  rewardedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([inviterId])
  @@map("invite_records")
}

// 佣金记录表（分销提成）
model CommissionRecord {
  id          Int      @id @default(autoincrement())
  userId      Int      // 获得佣金的用户（上级）
  user        User     @relation(fields: [userId], references: [id])
  fromUserId  Int      // 产生消费的下级用户
  orderId     Int?     // 关联订单
  amount      Int      // 佣金金额（星石）
  rate        Float    // 佣金比例
  status      String   @default("PENDING") @db.VarChar(20) // PENDING待结算 / SETTLED已结算
  settledAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([fromUserId])
  @@map("commission_records")
}

// ==================== 技能/声音标签 ====================

// 标签配置表
model SkillTag {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(50) // 标签名称：萝莉音/御姐音/技术流/娱乐型等
  category    String   @default("voice") @db.VarChar(20) // voice声音 / skill技能 / style风格
  icon        String?  @db.VarChar(255)
  sortOrder   Int      @default(0)
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())

  users       UserSkillTag[]

  @@map("skill_tags")
}

// 用户标签关联表
model UserSkillTag {
  id          Int      @id @default(autoincrement())
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tagId       Int
  tag         SkillTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([userId, tagId])
  @@index([tagId])
  @@map("user_skill_tags")
}

// 派单/转派记录表
model DispatchRecord {
  id            Int      @id @default(autoincrement())
  orderId       Int
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  operatorId    Int?     // 操作人（客服/管理员），自动派单时为null
  operator      User?    @relation("DispatchOperator", fields: [operatorId], references: [id])
  fromProviderId Int?    // 原陪玩ID（转派时填写）
  fromProvider  User?    @relation("DispatchFrom", fields: [fromProviderId], references: [id])
  toProviderId  Int?     // 目标陪玩ID
  toProvider    User?    @relation("DispatchTo", fields: [toProviderId], references: [id])
  type          String   @db.VarChar(20) // DISPATCH派单 / REDISPATCH转派 / AUTO自动派单 / GRAB抢单
  reason        String?  @db.Text // 转派原因
  createdAt     DateTime @default(now())

  @@index([orderId])
  @@index([operatorId])
  @@index([toProviderId])
  @@map("dispatch_records")
}

// ==================== 枚举定义 ====================

enum Role {
  CUSTOMER   // 老板
  PROVIDER   // 陪玩
  ADMIN      // 管理员
  OPERATOR   // 客服
}

enum UserStatus {
  ACTIVE    // 正常
  DISABLED  // 禁用
  FROZEN    // 冻结
}

enum Gender {
  MALE
  FEMALE
  UNKNOWN
}

enum OnlineStatus {
  ONLINE
  BUSY
  OFFLINE
}

enum ApplyStatus {
  PENDING   // 待审核
  APPROVED  // 已通过
  REJECTED  // 已拒绝
}

enum OrderStatus {
  CREATED      // 已创建（待支付）
  PAID         // 已支付（待接单/抢单池）
  ASSIGNED     // 已接单
  SERVING      // 服务中
  REVIEWING    // 待审核（已报单）
  COMPLETED    // 已完成
  CANCELLED    // 已取消
  EXPIRED      // 已过期
  DISPUTED     // 申诉中
}

enum ReviewStatus {
  PENDING   // 待审核
  APPROVED  // 审核通过
  REJECTED  // 审核驳回
}

enum EvidenceType {
  ENTER   // 入队截图
  END     // 结单截图
  RESULT  // 战绩截图
  OTHER   // 其他
}

enum TxnType {
  RECHARGE  // 充值
  CONSUME   // 消费（下单）
  INCOME    // 收入（订单结算）
  WITHDRAW  // 提现
  REFUND    // 退款
  REWARD    // 奖励
  PUNISH    // 惩罚
  GIFT      // 礼物
  FROZEN    // 冻结
  UNFROZEN  // 解冻
}

enum WithdrawStatus {
  PENDING   // 待审核
  APPROVED  // 已通过（待打款）
  PAID      // 已打款
  REJECTED  // 已拒绝
}

enum MessageType {
  SYSTEM  // 系统消息
  ORDER   // 订单消息
  NOTICE  // 公告
}
